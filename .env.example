# ====================================================================
# SEQOY Production Environment Configuration
# ====================================================================

# 1. DATABASE (Neon Serverless PostgreSQL, or any standard Postgres for local/dev)
# Neon: get your connection string from https://console.neon.tech
# Local dev: docker compose up, then use the connection string in docker-compose.yml
DATABASE_URL="postgres://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/seqoy?sslmode=require"

# 2. AUTH (Clerk) — https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. VOICE CALLS (Twilio) — the Delay-1 biweekly check-in call, and outbound WhatsApp
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+12025550199"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# 4. USSD & SMS (Africa's Talking) — Twilio does not offer Kenyan USSD short codes.
# Get credentials from https://account.africastalking.com
AFRICASTALKING_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_SHORTCODE="384"

# 5. WEBHOOK SHARED SECRETS — required in production; without them, an inbound
# USSD/HIMS webhook call could be spoofed by anyone who finds the URL.
USSD_WEBHOOK_SECRET="choose-a-long-random-string"
HIMS_WEBHOOK_SECRET="choose-a-different-long-random-string"
SMS_WEBHOOK_SECRET="choose-another-long-random-string"

# 6. CLINICAL SYMPTOM EXTRACTION (Claude) — optional; falls back to keyword
# matching with zero cost if unset.
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxx"

# 7. APP DEPLOYMENT
NEXT_PUBLIC_APP_URL="https://seqoy.vercel.app"

# 8. CRON PROTECTION — the header the scheduler must send to /api/cron/checkins
CRON_SECRET="choose-a-long-random-string"

# 9. EMERGENCY CLINIC NOTIFICATION CONTACT
EMERGENCY_CLINIC_PHONE="+254712345678"
