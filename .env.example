# ====================================================================
# seqoy Production Environment Configuration (Vercel + Neon + Manual Auth)
# ====================================================================

# 1. DATABASE (Neon Serverless PostgreSQL — recommended region: eu-central-1)
DATABASE_URL="postgres://username:password@ep-sample-pooler.eu-central-1.aws.neon.tech/seqoy?sslmode=require"

# 2. MANUAL SESSION AUTH (No Clerk required during Phase 1 pilot)
AUTH_SESSION_SECRET="replace-with-a-64-char-random-hex-string"
AUTH_ADMIN_EMAIL="admin@seqoy.health"
AUTH_ADMIN_PASSWORD="replace-with-strong-admin-password"
AUTH_STAFF_PASSWORD="replace-with-strong-staff-password"

# 3. USSD & SMS (Africa's Talking — add live keys when ready for SMS pilot)
AFRICASTALKING_API_KEY="dummy_at_api_key_replace_later"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_SHORTCODE="384"

# 4. WEBHOOK & CRON SECRETS (Fail-closed in production)
CRON_SECRET="replace-with-random-secret"
SMS_WEBHOOK_SECRET="replace-with-random-secret"
USSD_WEBHOOK_SECRET="replace-with-random-secret"
HIMS_WEBHOOK_SECRET="replace-with-random-secret"

# 5. APP DEPLOYMENT
NEXT_PUBLIC_APP_URL="https://seqoy.vercel.app"
EMERGENCY_CLINIC_PHONE="+254712345678"
